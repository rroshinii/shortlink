package com.shortlink.service;

import com.shortlink.repository.ClickLogRepository;
import com.shortlink.repository.UrlRepository;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;

@Service
public class ExpiredLinkCleanupService {

    private static final Logger log = LoggerFactory.getLogger(ExpiredLinkCleanupService.class);

    private final UrlRepository urlRepository;
    private final ClickLogRepository clickLogRepository;
    private final int retentionDays;

    public ExpiredLinkCleanupService(UrlRepository urlRepository,
                                     ClickLogRepository clickLogRepository,
                                     @Value("${app.cleanup.retention-days:7}") int retentionDays) {
        this.urlRepository = urlRepository;
        this.clickLogRepository = clickLogRepository;
        this.retentionDays = retentionDays;
    }

    // Default: every day at 2:00 AM. Format: second minute hour day month weekday
    @Scheduled(cron = "${app.cleanup.cron:0 0 2 * * *}")
    @Transactional
    public void deleteExpiredLinks() {
        LocalDateTime cutoff = LocalDateTime.now().minusDays(retentionDays);

        int logs = clickLogRepository.deleteLogsOfExpiredUrls(cutoff);
        int links = urlRepository.deleteExpiredBefore(cutoff);

        log.info("Cleanup finished: removed {} expired links and {} click logs (cutoff {})",
                links, logs, cutoff);
    }
}